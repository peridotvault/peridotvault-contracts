# Secrets hygiene (ANT-504): ignore real env files at any depth.
# *.env.example files are NOT matched by these patterns and stay tracked.
*.env
.env.*
!.env.example

# Secrets hygiene (ANT-885 C-1): deployer key material was tracked here.
# File stays in working tree for local custody ops, never in git.
notes/account.txt
