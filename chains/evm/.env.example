# Copy to .env and fill in. NEVER commit .env (it is git-ignored).
# All values below are placeholders — replace locally, keep fakes out of git.
#
# Required for testnet deploys (chains/evm/hardhat.config.ts):
DEPLOYER_PRIVATE_KEY="0xYOUR_PRIVATE_KEY_HERE"
LISK_SEPOLIA_RPC="https://rpc.sepolia-api.lisk.com"
BASE_SEPOLIA_RPC="https://sepolia.base.org"

# Required only for the `sepolia` network profile (hardhat config variables;
# settable via env or `npx hardhat keystore set <NAME>`):
SEPOLIA_RPC_URL="https://YOUR_SEPOLIA_RPC_HERE"
SEPOLIA_PRIVATE_KEY="0xYOUR_PRIVATE_KEY_HERE"

# Required by scripts/deploy-registry-factory.ts:
PGC1_IMPL="0xYOUR_PGC1_IMPLEMENTATION_ADDRESS_HERE"

# Optional (scripts/deploy-registry-factory.ts, scripts/deploy.ts):
# Empty/unset = zero address (ETH mode) / built-in defaults.
FEE_TOKEN="0x0000000000000000000000000000000000000000"
PUBLISH_FEE_WEI="10000000000000"
TREASURY_ADDRESS="0xYOUR_TREASURY_ADDRESS_HERE"

# Optional test flag (chains/evm/test/M2Attestation.ts):
# WRITE_VECTORS=1 regenerates the committed cross-stack fixture.
WRITE_VECTORS="0"

# Legacy / unused by current scripts — kept so old local setups keep parsing.
DEPLOYER_SEEDPHRASE=""
DEPLOYER_PUBLIC_KEY=""
